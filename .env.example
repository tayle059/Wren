# Meta Model API key from https://dev.meta.ai. Without it, Kindred runs on its
# built-in offline demo brain and the browser's own speech recognition.
META_API_KEY=

# Optional overrides
META_API_BASE=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_VISION_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0

PORT=8787
# Where the SQLite database and uploaded media live
DATA_DIR=./data
# Public URL used in push notification links
PUBLIC_URL=http://localhost:8787

# Sign in with Google, Apple and Facebook (each turns on when its keys are set).
# Redirect URL to register with each provider: <PUBLIC_URL>/api/auth/oauth/<google|apple|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=        # your Services ID, e.g. com.yourname.kindred.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # contents of the .p8 key; newlines may be written as \n
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
